##############################################################################
# SDK Setup image
FROM ubuntu:latest

ENV SDK_PATH="/opt/ppc-amigaos/ppc-amigaos/SDK"

ENV CCRED="\033[31m" \
    CCGREEN="\033[32m" \
    CCYELLOW="\033[33m" \
    CCBLUE="\033[34m" \
    CCPINK="\033[35m" \
    CCLBLUE="\033[36m" \
    CCEND="\033[0m" \
    CCBOLD="\033[1m" \
    CCITAL="\033[3m" \
    CCUNDR="\033[4m"

ENV PACKAGES=" \
    build-essential \
    ca-certificates \
    curl \
    git \
    python3"

COPY scripts/setup-rust.sh /setup-rust.sh

RUN apt-get update && apt-get -y dist-upgrade && \
    apt-get -y --no-install-recommends install ${PACKAGES} && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*; \
    chmod +x /setup-rust.sh && \
    bash /setup-rust.sh && rm /setup-rust.sh && rm -rf /tmp/rust; \
